# Go binary
/vineyard
dist/

# Grapes temp files
.grapes/*/tmp/
.grapes/tmp/

# Grapes ID-allocation lock and interrupted atomic writes
.grapes/.lock
.grapes/*/.lock
.grapes/config.toml.lock
.grapes/.*.tmp-*
.grapes/*/.*.tmp-*

# Local builds against a grapes checkout (see docs/development.md)
go.work
go.work.sum
